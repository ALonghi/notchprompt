<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The complete set of permissions the locally built app gets.
  - app-sandbox: macOS confines the process (kernel-enforced).
  - files.user-selected.read-write: it may touch only files you pick in an
    Open/Save dialog.
  Anything left out is denied. In particular there is no network.client or
  network.server entitlement, so the app cannot open any network connection.
  scripts/sandboxed.sh refuses to finish unless the signed app carries exactly
  these two keys.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
